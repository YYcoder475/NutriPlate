<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NutriPlate.Views.SignUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:NutriPlate.ViewModels"
    Title="SignUpPage"
    x:DataType="views:SignUpViewModel"
    FlowDirection="LeftToRight">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="Purple" />
            <GradientStop Offset="0.5" Color="Orange" />
            <GradientStop Offset="1.0" Color="LightGreen" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid ColumnDefinitions="*,8*,*" RowDefinitions="*,4*,*">
        <HorizontalStackLayout
            Grid.Column="1"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <!--  כותרת  -->
            <Label
                FontSize="24"
                Text="Create Account"
                TextColor="White" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
            <!--  שדה שם משתמש  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Entry
                    FontSize="18"
                    Placeholder="UserName"
                    Text="{Binding UserName}"
                    TextColor="Wheat" />
            </Border>

            <!--  שדה שם פרטי  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Entry
                    FontSize="18"
                    Placeholder="First Name"
                    Text="{Binding FirstName}"
                    TextColor="Wheat" />
            </Border>

            <!--  שדה שם משפחה  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Entry
                    FontSize="18"
                    Placeholder="Last Name"
                    Text="{Binding LastName}"
                    TextColor="Wheat" />
            </Border>

            <!--  שדה דואל  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Style="{StaticResource FormBorders}">

                <Entry
                    FontSize="18"
                    Keyboard="Email"
                    Placeholder="Email"
                    Style="{StaticResource FormEntry}"
                    Text="{Binding Email}"
                    TextColor="Wheat">

                    <Entry.Behaviors>
                        <toolkit:EmailValidationBehavior
                            Flags="ValidateOnValueChanged"
                            InvalidStyle="{StaticResource InvalidEntryStyle}"
                            ValidStyle="{StaticResource ValidEntryStyle}" />
                    </Entry.Behaviors>
                </Entry>

            </Border>

            <!--  שדה סיסמה  -->
            <Border
                Margin="0,0,0,10"
                Stroke="#ccc"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Grid
                    Padding="10"
                    ColumnDefinitions="*,Auto"
                    VerticalOptions="Center">
                    <Entry
                        BackgroundColor="Transparent"
                        FontSize="18"
                        IsPassword="{Binding IsPassword}"
                        Placeholder="Password"
                        Text="{Binding UserPassword}"
                        TextColor="Wheat"
                        VerticalOptions="Center" />
                    <Button
                        Margin="5,0,0,0"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Command="{Binding ShowPasswordCommand}"
                        FontFamily="MyMaterialSymbols"
                        FontSize="24"
                        HorizontalOptions="End"
                        Text="{Binding EyeIcon}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  שדה מספר טלפון  -->
            <Border
                Margin="0,0,0,10"
                Padding="10"
                Stroke="#ccc"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Entry
                    FontSize="18"
                    Keyboard="Telephone"
                    Placeholder="Mobile"
                    Text="{Binding Mobile}"
                    TextColor="Wheat" />
            </Border>

            <!--  כפתור כניסה  -->
            <Button
                Command="{Binding SignUpCommand}"
                CornerRadius="8"
                FontSize="20"
                HeightRequest="70"
                Text="Sign Up"
                TextColor="White" />

            <!--  Already have an account?  -->
            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Label
                    Margin="14,0,0,0"
                    FontSize="16"
                    Text="Already have an account?"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
                <Button
                    BackgroundColor="Transparent"
                    Command="{Binding NavigateToSignInCommand}"
                    FontSize="16"
                    Text="SignIn"
                    TextColor="Blue" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

    </Grid>
</ContentPage>